{
  "name": "@ftptech/x402-canton-ledger",
  "version": "0.6.5",
  "description": "Canton ledger primitives for x402: a JSON Ledger API v2 client, Ed25519 external-party signing and a Scan client.",
  "license": "Apache-2.0",
  "author": "FTP team",
  "homepage": "https://github.com/FTP-Tech-LLC/x402-canton-facilitator/tree/main/packages/ledger#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FTP-Tech-LLC/x402-canton-facilitator.git",
    "directory": "packages/ledger"
  },
  "bugs": {
    "url": "https://github.com/FTP-Tech-LLC/x402-canton-facilitator/issues"
  },
  "keywords": [
    "x402",
    "canton",
    "canton-network",
    "daml",
    "json-ledger-api",
    "splice"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint src --max-warnings 0"
  },
  "dependencies": {
    "@canton-network/core-tx-visualizer": "~1.4.0"
  },
  "devDependencies": {
    "@canton-network/core-ledger-proto": "~1.4.0"
  },
  "publishConfig": {
    "access": "public"
  }
