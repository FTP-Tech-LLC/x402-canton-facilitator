# Canton x402 facilitator, dedicated host, MainNet env template.
# Copy to .env next to docker-compose.yml and fill in. Never commit the filled
# file. Full reference: docs/deployment.md.

# --- Image and domain ---
IMAGE_TAG=canton-x402-facilitator:REPLACE_ME
# DNS A record of this domain points at this host. Caddy gets the certificate.
FACILITATOR_DOMAIN=facilitator.example.com

# --- Network and participant ---
CANTON_NETWORK=canton:mainnet
# The participant's JSON Ledger API over a private link (VPN). Never public.
CANTON_PARTICIPANT_URL=http://REPLACE_ME:7575
CANTON_FACILITATOR_PARTY=REPLACE_ME::1220REPLACE_ME
# MainNet global synchronizer.
CANTON_SYNCHRONIZER_ID=global-domain::1220b1431ef217342db44d516bb9befde802be7d8899637d290895fa58880f19accc
# The participant member id, PAR::<participant uid>. Required with markers on.
CANTON_FACILITATOR_MEMBER_ID=

# --- Scan ---
# MainNet SV Scans admit only allowlisted IPs. If this host is not on the
# allowlist, reach Scan through a host that is (for example your validator) and
# keep the Scan host name in the URL. Use no port in the URL: some Scan gateways
# refuse a Host header that carries one.
CANTON_SCAN_URL=https://REPLACE_ME
CANTON_SCAN_FLAVOR=sv
# true sends the OIDC token to Scan. Set it only if your Scan read requires it.
CANTON_SCAN_AUTH=false
# Other SV Scans tried when the primary keeps failing (comma-separated).
CANTON_SCAN_FALLBACK_URLS=

# --- Participant auth (OIDC client credentials) ---
JWT_ISSUER=oidc
OIDC_TOKEN_ENDPOINT=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPE=
LEDGER_API_AUDIENCE=
CANTON_USER_ID=

# --- Settlement ---
# Must be true to settle. Off, /settle refuses every payment and the relay
# pay routes answer 503.
CANTON_X402_TF_ENABLED=true
# executeBefore horizon in seconds: default when the client asks for none, and
# the ceiling on what it may ask for.
# CANTON_X402_TF_DEFAULT_EXECUTE_BEFORE_S=120
# CANTON_X402_TF_MAX_EXECUTE_BEFORE_S=600

# Topology reader: where the facilitator reads a payer's signing key. Required.
# Unset, every payment is refused with invalid_exact_canton_signature_invalid.
CANTON_X402_TOPOLOGY_READER_URL=http://REPLACE_ME:8099
CANTON_X402_TOPOLOGY_READER_TOKEN=

# Which merchants this facilitator pays traffic for.
#   open                   anyone (default)
#   provider               merchants whose preapproval names this facilitator as provider
#   allowlist              merchants listed below
#   provider-or-allowlist  either proof
# Do not use bare provider: a self-provisioned preapproval names the merchant
# itself as provider, so most honest traffic would be refused.
# CANTON_X402_INLINE_MERCHANT_POLICY=open
# CANTON_X402_INLINE_MERCHANT_ALLOWLIST=

# Guard for a settle whose outcome never came back: off | observe | enforce.
# off (default) reports it as a failure, and a payer that pays again pays twice.
# Roll out off, then observe (metric only), then enforce (503 + Retry-After).
CANTON_X402_SETTLE_DISPATCH_MARK=off

# A previous facilitator party still accepted as extra.feePayer while merchants
# update their configs (comma-separated). /supported shows only the current one.
# CANTON_X402_ACCEPTED_FEE_PAYERS=

# --- CIP-56 registry tokens (optional; empty = Canton Coin only) ---
# JSON, keyed by instrument admin party:
#   TOKEN_REGISTRIES          {"<admin>":"<registry base URL>"}
#   TOKEN_INSTRUMENTS         {"<admin>":{"id":"<instrument id>","symbol":"<SYM>"}}
#   REGISTRY_TRUSTED_PARTIES  {"<admin>":["<registry operator>","<bridge operator>"]}
# CANTON_X402_TOKEN_REGISTRIES=
# CANTON_X402_TOKEN_INSTRUMENTS=
# CANTON_X402_REGISTRY_TRUSTED_PARTIES=

# --- Proxy and rate limits (sliding 60s window; 0 disables a cap) ---
# Caddy reaches the facilitator over the docker network: trust private ranges.
CANTON_X402_TRUST_PROXY=uniquelocal
CANTON_X402_SETTLE_RATE_MAX_PER_PAYER=10
CANTON_X402_SETTLE_RATE_MAX_PER_IP=100
CANTON_X402_SETTLE_RATE_MAX_GLOBAL=120
CANTON_X402_VERIFY_RATE_MAX_PER_IP=120

# --- Agent-wallet relay (/v1/wallet/*; prepares, never signs) ---
CANTON_X402_ENABLE_AGENT_WALLET=false
# When set, every relay call must send X-Agent-Key: <value>.
# CANTON_X402_AGENT_WALLET_KEY=
# Party allocations per day across all callers (0 disables).
CANTON_X402_WALLET_ONBOARD_DAILY_MAX=200
# Temporary ban for callers refused again and again on relay money routes.
# 5 strikes in 10 min: 1h ban, doubling up to 24h. STRIKES_TO_BAN=0 disables.
CANTON_X402_ABUSE_STRIKES_TO_BAN=5
# Tradecraft queued mode (canton-agent-wallet `tc`). Off unless all three are set.
# CANTON_X402_WALLET_SUBMIT_CHOICES=TransferFactory_Transfer,TransferInstruction_Accept,AMMRules_CreateSwapOrderBatcher,AMMRules_CreateSettlementAllocation,AMMRules_FundSettlementAllocation,SwapOrderBatcher_CreateOrdersV2,SwapOrder_WithdrawV3
# CANTON_X402_WALLET_SUBMIT_CREATE_TEMPLATES=TC.V4.Settle.WithdrawalRequest:SettlementWithdrawalRequest
# CANTON_X402_WALLET_READ_IDS=#canton-swap-amm-vault:TC.V4.OrderBatch:SwapOrderBatcher,#canton-swap-amm-vault:TC.V4.SwapOrderV2:SwapOrder,#splice-api-token-allocation-v2:Splice.Api.Token.AllocationV2:Allocation

# --- Faucet and starter grant (sends real CC from the facilitator party) ---
# Needs the relay on and DATABASE_URL. ON_ONBOARD sends one grant to every new
# wallet. Set INTERNAL_SECRET whenever the faucet is on: unset, anyone can call
# POST /v1/wallet/faucet/claim.
CANTON_X402_FAUCET_ENABLED=false
CANTON_X402_FAUCET_ON_ONBOARD=false
# CANTON_X402_FAUCET_INTERNAL_SECRET=
CANTON_X402_FAUCET_AMOUNT_CC=0.02
CANTON_X402_FAUCET_MAX_PER_IP=5
CANTON_X402_FAUCET_DAILY_BUDGET_CC=1
CANTON_X402_FAUCET_LIFETIME_CAP_CC=25

# --- Operator routes ---
# Bearer token for the merchant registry, the preapproval provider route and
# /attribution. Unset: those routes answer 503.
CANTON_X402_OPERATOR_TOKEN=
# Legacy facilitator-as-provider preapproval route. Merchants self-provision.
CANTON_X402_ENABLE_PREAPPROVAL_PROVIDER=false

# --- Bazaar (GET /discovery/resources) ---
# JSON array of {resource, type, accepts, metadata}. Keep accepts identical to
# the resource's own 402.
# CANTON_X402_DISCOVERY_RESOURCES=

# --- App-reward markers (optional; needs a FeaturedAppRight) ---
# One FeaturedAppActivityMarker per mining round, weighted by the participant's
# traffic. Needs DATABASE_URL and CANTON_FACILITATOR_MEMBER_ID.
CANTON_X402_MARKER_ENABLED=false
# CANTON_X402_MARKER_FTP_PARTY=
# CANTON_X402_MARKER_USER_ID=
# CANTON_X402_MARKER_BENEFICIARY=
# CANTON_X402_MARKER_WEIGHT_MULTIPLIER=1.15

# --- Postgres ---
POSTGRES_USER=x402
POSTGRES_PASSWORD=
POSTGRES_DB=x402
POSTGRES_DATA_DIR=./postgres-data

LOG_LEVEL=info
