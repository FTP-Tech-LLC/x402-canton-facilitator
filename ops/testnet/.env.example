# Canton x402 facilitator, TestNet env template.
# Copy to .env next to docker-compose.yml and fill in the REPLACE_ME values.
# Never commit the filled file. Full reference: docs/deployment.md.

# --- Network ---
CANTON_NETWORK=canton:testnet

# --- Participant ---
# JSON Ledger API v2, reached by service name on the validator's docker network.
CANTON_PARTICIPANT_URL=http://participant:7575
# The facilitator party on this participant (see docs/deployment.md, "Party and rights").
CANTON_FACILITATOR_PARTY=REPLACE_ME::1220REPLACE_ME
# The TestNet global synchronizer id, global-domain::1220<64 hex>. See docs/deployment.md.
CANTON_SYNCHRONIZER_ID=global-domain::1220REPLACE_ME

# --- Scan ---
# Public SV Scan for TestNet. sv = SV Scan, validator = the validator's scan proxy.
CANTON_SCAN_URL=https://scan.sv-1.test.global.canton.network.sync.global
CANTON_SCAN_FLAVOR=sv
# true sends the OIDC token to Scan. Leave false unless your Scan requires it.
CANTON_SCAN_AUTH=false

# --- Participant auth (OIDC client credentials) ---
# Use a client made for the facilitator. Do not reuse the validator's own client.
JWT_ISSUER=oidc
OIDC_TOKEN_ENDPOINT=https://REPLACE_ME/oauth/token
OIDC_CLIENT_ID=REPLACE_ME
OIDC_CLIENT_SECRET=REPLACE_ME
OIDC_SCOPE=daml_ledger_api
# The audience your participant validates. Confirm it with the participant config.
LEDGER_API_AUDIENCE=https://canton.network.global
# The ledger user the token maps to (often <client id>@clients on Auth0).
CANTON_USER_ID=REPLACE_ME@clients

# --- Settlement ---
# Must be true to settle anything. Off, every payment is refused.
CANTON_X402_TF_ENABLED=true
# Where the facilitator reads a payer's signing key. Required: unset, every
# payment is refused with invalid_exact_canton_signature_invalid.
CANTON_X402_TOPOLOGY_READER_URL=http://REPLACE_ME:8099
CANTON_X402_TOPOLOGY_READER_TOKEN=REPLACE_ME

# --- Postgres ---
POSTGRES_USER=x402
# openssl rand -base64 32
POSTGRES_PASSWORD=REPLACE_ME
POSTGRES_DB=x402
POSTGRES_DATA_DIR=./postgres-data

# --- Container ---
IMAGE_TAG=canton-x402-facilitator:latest
LOG_LEVEL=info
FACILITATOR_BIND=127.0.0.1
# The TLS proxy reaches the container over Docker networking, so trust private
# ranges. Otherwise every client shares one rate-limit bucket.
CANTON_X402_TRUST_PROXY=uniquelocal

# --- Optional ---
# Bearer token for operator routes (merchant registry, /attribution).
# Unset: those routes answer 503.
CANTON_X402_OPERATOR_TOKEN=
# Agent-wallet relay (/v1/wallet/*). Prepares, never signs.
CANTON_X402_ENABLE_AGENT_WALLET=false
# When set, every /v1/wallet/* call must send X-Agent-Key: <value>.
CANTON_X402_AGENT_WALLET_KEY=
# POST /close is an unauthenticated process exit for the conformance harness.
# Never enable it on a reachable host.
CANTON_X402_ENABLE_CLOSE_ROUTE=false
